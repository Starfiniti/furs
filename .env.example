# Public/non-secret runtime configuration only. Put secret values in files under
# a protected directory outside this repository and mount them read-only.
FURS_ENVIRONMENT=test
FURS_API_PORT=8080
FURS_API_MAXIMUM_REQUESTS_PER_MINUTE=600
DATABASE_URL=postgresql://furs_api_login@postgres:5432/furs
DATABASE_PASSWORD_FILE=/run/secrets/furs-api-database-password
FURS_LEGAL_ENTITY_ID=replace-with-provisioned-legal-entity-uuid
FURS_LEGAL_ENTITY_NAME=Starfiniti d.o.o.
# Compose host path to an 8-digit tax-number file (do not commit it):
FURS_LEGAL_ENTITY_TAX_NUMBER_FILE=replace-with-protected-host-path
# Copy the source-review template, name the human reviewer, and mount it here:
FURS_COMPLIANCE_SOURCE_MANIFEST_FILE=replace-with-reviewed-host-path
FURS_CERTIFICATE_PATH=/run/secrets/furs-certificate.p12
FURS_CERTIFICATE_PASSPHRASE_FILE=/run/secrets/furs-certificate-passphrase
# Compose host paths to distinct random credentials (32+ characters each):
FURS_API_READ_TOKEN_FILE=replace-with-protected-host-path
FURS_API_WRITE_TOKEN_FILE=replace-with-protected-host-path
FURS_OWNER_DB_PASSWORD_FILE=replace-with-protected-host-path
FURS_API_DB_PASSWORD_FILE=replace-with-protected-host-path
FURS_WORKER_DB_PASSWORD_FILE=replace-with-protected-host-path
FURS_CERTIFICATE_FILE=replace-with-protected-host-path
FURS_CERTIFICATE_PASSPHRASE_FILE=replace-with-protected-host-path
FURS_SCHEMA_FILE=replace-with-reviewed-host-path
FURS_SERVER_CA_FILE=replace-with-reviewed-host-path
FURS_RESPONSE_CA_FILE=replace-with-reviewed-host-path
# Durable result webhook used by the Compose worker (HTTPS required):
FURS_WEBHOOK_DESTINATION_ID=primary
FURS_WEBHOOK_URL=https://adapter.example/furs-result
FURS_WEBHOOK_SECRET_FILE=replace-with-protected-host-path
FURS_INVOICE_SCHEMA_PATH=/run/schemas/FiscalVerificationSchema.json
FURS_INVOICE_SCHEMA_SHA256=replace-with-reviewed-sha256
FURS_RESPONSE_SCHEMA_PATH=/run/schemas/FiscalVerificationSchema.json
FURS_RESPONSE_SCHEMA_SHA256=replace-with-reviewed-sha256
FURS_SERVER_CA_PATHS_JSON=["/run/trust/furs-server-ca.pem"]
FURS_RESPONSE_CA_PATHS_JSON=["/run/trust/furs-response-ca.pem"]
# Use at least two independently operated, deployment-reviewed NTP servers.
FURS_NTP_SERVERS_JSON=["time.cloudflare.com","time.google.com"]
FURS_NTP_MINIMUM_RESPONSES=2
FURS_NTP_TIMEOUT_MS=2000
FURS_MAX_CLOCK_DRIFT_MS=5000
FURS_CERTIFICATE_MINIMUM_DAYS=14
FURS_RUN_MIGRATIONS=false
